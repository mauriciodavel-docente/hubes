{
  "buildCommand": "cd frontend && npm install && npm run build && cd ../backend && npm run prisma:generate",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.mjs": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.mjs?__path=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
